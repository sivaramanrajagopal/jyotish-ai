# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
# JWT Secret — Supabase → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── AI APIs ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── Payments / Email (optional) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=

# ── CORS: comma-separated list of allowed frontend origins ───────────────────
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app,https://jyotish-ai.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# Set to "production" on Render for strict security checks

# ── Admin (bulk Panchangam preload) — send as header X-Admin-Token, NOT query ─
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Security ──────────────────────────────────────────────────────────────────
# Max JSON request body size in bytes (default 256 KB)
MAX_JSON_BODY_BYTES=262144

# Daily AI quotas per authenticated user (Step 7)
AI_DAILY_CHAT_LIMIT=40
AI_DAILY_FORECAST_LIMIT=25
