# Frontend environment (Vercel → Settings → Environment Variables)
# Copy to .env.local for local dev — never commit .env.local

# Backend API URL (required)
# Local:  http://localhost:8000
# Prod:   https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase Auth (Step 2 — public keys only; safe for browser)
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
