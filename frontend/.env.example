# Frontend environment (Vercel → Settings → Environment Variables)
# Copy to .env.local for local dev — never commit .env.local

# Backend API URL (required)
# Local:  http://localhost:8000
# Prod:   https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase Auth (Step 2 — public keys only; safe for browser)
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Magic-link redirect target (required on Vercel — prevents links going to localhost)
# Production: https://jyotish-ai-zeta.vercel.app
# Local:      http://localhost:5173
VITE_SITE_URL=https://jyotish-ai-zeta.vercel.app

# Owner admin tab — must match ADMIN_EMAILS on Render (comma-separated)
VITE_ADMIN_EMAILS=adtrackmail@gmail.com

# Public contact for Terms / Privacy (optional — defaults to admin email)
VITE_CONTACT_EMAIL=adtrackmail@gmail.com
